# Hosted Chroma server connection for the AI coach retriever (backend/bingeBuddyAPI/chatbot_utilities.py)
CHROMA_URL=your-chroma-host.example.com # hostname only, no scheme (e.g. chroma-production.up.railway.app)
CHROMA_PORT=443 # port the Chroma server listens on
CHROMA_COLLECTION_NAME=ai-coach-collection # name of the pre-built collection to retrieve from; defaults to ai-coach-collection if unset
